{
"compilerOptions": {
"target": "ES2021",
"module": "ESNext",
"moduleResolution": "Bundler",
"resolveJsonModule": true,
"esModuleInterop": true,
"strict": true,
"baseUrl": ".",
"paths": {
"@pages/*": ["src/pages/*"],
"@utils/*": ["src/utils/*"],
"@fixtures/*": ["fixtures/*"]
},
"types": ["@playwright/test"],
"outDir": "dist"
},
"include": ["src", "tests", "fixtures", "playwright.config.ts"]
}